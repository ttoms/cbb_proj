// arbiter_wrr 断言与参数检查（由 SVA_ON 控制 include）

initial begin
    if (N < 1) begin
        $fatal(1, "[%m] N must be >= 1, got %0d", N);
    end
    if (WEIGHT_W < 1) begin
        $fatal(1, "[%m] WEIGHT_W must be >= 1, got %0d", WEIGHT_W);
    end
end

// 授权至多一路
a_gnt_onehot: assert property (
    @(posedge clk) disable iff (!rst_n) gnt_vld |-> $onehot(gnt)
);

// 有有效请求（weight>0）必有授权
a_gnt_vld_req: assert property (
    @(posedge clk) disable iff (!rst_n) (gnt_vld == (|req_w))
);

// 授权只能落在请求位图上
a_gnt_subset: assert property (
    @(posedge clk) disable iff (!rst_n) ((gnt & ~req) == '0)
);

// 无授权或授权未被消费时 ptr 与 credit 保持
a_ptr_stable: assert property (
    @(posedge clk) disable iff (!rst_n) (!gnt_vld || !upd) |=> $stable(ptr)
);

a_credit_stable: assert property (
    @(posedge clk) disable iff (!rst_n) (!gnt_vld || !upd) |=> $stable(credit)
);

// 授权被消费后 ptr 指向被授权索引的下一路
a_ptr_advance: assert property (
    @(posedge clk) disable iff (!rst_n) (gnt_vld && upd) |=> (
        ptr == (($past(gnt_idx) == IDX_W'(N - 1)) ? '0 : ($past(gnt_idx) + 1'b1))
    )
);

// credit 不应超过配置权重
genvar gi;
generate
    for (gi = 0; gi < N; gi++) begin : g_credit_bound
        a_credit_bound: assert property (
            @(posedge clk) disable iff (!rst_n) (
                credit[gi*WEIGHT_W +: WEIGHT_W] <= weight[gi*WEIGHT_W +: WEIGHT_W]
            )
        );
    end
endgenerate
